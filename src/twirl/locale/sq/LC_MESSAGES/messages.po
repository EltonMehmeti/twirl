#: src/twirl/web/shop_catalog.py:64
msgid "That dress is already booked or blocked on those dates."
msgstr "Ky fustan është tashmë i rezervuar ose i bllokuar në ato data."

#: src/twirl/web/shop_catalog.py:65
msgid "The block end date must be on or after the start date."
msgstr "Data e mbarimit të bllokimit duhet të jetë e njëjtë ose pas datës së fillimit."

#: src/twirl/web/shop_catalog.py:66
msgid "Enter both dates and a reason for the block."
msgstr "Shkruani të dyja datat dhe arsyen e bllokimit."

#: src/twirl/web/shop_catalog.py:67
msgid "This dress still has upcoming bookings. Swap them to another dress."
msgstr "Ky fustan ka ende rezervime të ardhshme. Kalojini ato në një fustan tjetër."

#: src/twirl/web/shop_catalog.py:70
msgid "That photo is larger than 15 MB."
msgstr "Kjo foto është më e madhe se 15 MB."

#: src/twirl/web/shop_catalog.py:71
msgid "That file is not a photo."
msgstr "Ky skedar nuk është foto."

#: src/twirl/web/shop_catalog.py:72
msgid "Use JPEG, PNG or WebP photos."
msgstr "Përdorni foto JPEG, PNG ose WebP."

#: src/twirl/web/shop_catalog.py:73
msgid "A dress can have at most 8 photos."
msgstr "Një fustan mund të ketë më së shumti 8 foto."

#: src/twirl/web/shop_catalog.py:341
msgid "Enter a size and a quantity from 1 to 20."
msgstr "Shkruani masën dhe një sasi nga 1 deri në 20."

