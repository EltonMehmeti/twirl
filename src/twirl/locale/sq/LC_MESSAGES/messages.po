#: src/twirl/templates/home.html:89
msgid "Next"
msgstr "Para"

#: src/twirl/templates/home.html:97
msgid "See all dresses"
msgstr "Shih të gjitha veshjet"

#: src/twirl/templates/home.html:102
msgid "Nothing free with these filters."
msgstr "Asgjë e lirë me këta filtra."

#: src/twirl/templates/home.html:107
msgid "All categories"
msgstr "Të gjitha kategoritë"

#: src/twirl/templates/home.html:116
msgid "The first dresses are on their way."
msgstr "Veshjet e para po vijnë."

#: src/twirl/templates/home.html:117
msgid "Shops are putting their collections online. Come back soon."
msgstr "Dyqanet po i vendosin koleksionet online. Kthehu së shpejti."

#: src/twirl/templates/home.html:124
msgid "Shops"
msgstr "Dyqanet"

#: src/twirl/templates/home.html:132
msgid "Verified"
msgstr "I verifikuar"

#: src/twirl/templates/home.html:133 src/twirl/templates/shop/base.html:9
#: src/twirl/templates/shop/styles.html:4 src/twirl/templates/storefront/shop.html:15
msgid "Dresses"
msgstr "Fustanet"

#: src/twirl/templates/home.html:144
msgid "Have a dress to rent out?"
msgstr "Ke veshje për t'i dhënë me qira?"

#: src/twirl/templates/home.html:145
msgid "Salons and individuals list for free. A phone number is enough to start."
msgstr "Sallonet dhe individët listojnë falas. Mjafton një numër telefoni për të filluar."

#: src/twirl/templates/auth/code.html:3 src/twirl/templates/auth/phone.html:3 src/twirl/web/auth.py:73
#: src/twirl/web/auth.py:139
msgid "Provider login"
msgstr "Hyrja për ofruesit"

#: src/twirl/templates/auth/code.html:8
msgid "Code from the SMS"
msgstr "Kodi nga SMS"

#: src/twirl/templates/auth/code.html:9
#, python-brace-format
msgid "We sent the code to {phone}."
msgstr "Kodi u dërgua në {phone}."

#: src/twirl/templates/auth/code.html:13
msgid "Six digits"
msgstr "Gjashtë numra"

#: src/twirl/templates/auth/code.html:15
msgid "The code expires after 5 minutes."
msgstr "Kodi skadon pas 5 minutash."

#: src/twirl/templates/auth/code.html:18
msgid "Development only, no SMS provider configured. Code:"
msgstr "Vetëm për zhvillim, nuk ka ofrues SMS. Kodi:"

#: src/twirl/templates/auth/code.html:20
msgid "Send the code again"
msgstr "Dërgo kodin prapë"

#: src/twirl/templates/auth/code.html:20
#, python-brace-format
msgid "Send again in {s}s"
msgstr "Dërgo prapë pas {s}s"

#: src/twirl/templates/auth/code.html:21
msgid "Change the number"
msgstr "Ndrysho numrin"

#: src/twirl/templates/auth/code.html:23
msgid "Verify the number"
msgstr "Verifiko numrin"

#: src/twirl/templates/auth/login.html:11
msgid "Email"
msgstr "Email"

#: src/twirl/templates/auth/login.html:12
msgid "Password"
msgstr "Fjalëkalimi"

#: src/twirl/templates/auth/login.html:13
msgid "Log in"
msgstr "Hyni"

#: src/twirl/templates/auth/login.html:16
msgid "Log in with your phone number"
msgstr "Hyr me numrin e telefonit"

#: src/twirl/templates/auth/login.html:17
msgid "New here? List your clothes"
msgstr "I ri këtu? Listo veshjen"

#: src/twirl/templates/auth/phone.html:8 src/twirl/web/onboarding.py:189
msgid "Phone number"
msgstr "Numri i telefonit"

#: src/twirl/templates/auth/phone.html:13
msgid "Number"
msgstr "Numri"

#: src/twirl/templates/auth/phone.html:15
msgid "Not shown publicly. Used for the code and for bookings."
msgstr "Nuk shfaqet publikisht. Shërben për kodin dhe për rezervimet."

#: src/twirl/templates/auth/phone.html:18
msgid "Send the code"
msgstr "Dërgo kodin"

#: src/twirl/templates/layouts/vesha.html:22 src/twirl/templates/layouts/vesha.html:24
msgid "Steps"
msgstr "Hapat"

#: src/twirl/templates/layouts/vesha.html:44
msgid "for providers"
msgstr "për ofruesit"

#: src/twirl/templates/onboarding/_photos.html:2 src/twirl/templates/shop/style_edit.html:13
#: src/twirl/web/onboarding.py:803
msgid "Photos"
msgstr "Fotot"

#: src/twirl/templates/onboarding/_photos.html:9
msgid "Remove photo"
msgstr "Hiq foton"

#: src/twirl/templates/onboarding/_photos.html:16
msgid "Add a photo"
msgstr "Shto foto"

#: src/twirl/templates/onboarding/_photos.html:22
msgid "At least 3 photos. Daylight, no filters: the “as pictured” promise is judged against these."
msgstr "Së paku 3 foto. Dritë dite, pa filtra — garancia «si në foto» matet me këto."

#: src/twirl/templates/onboarding/done.html:4 src/twirl/templates/storefront/shop.html:13
#: src/twirl/templates/storefront/style.html:25 src/twirl/templates/storefront/style.html:56
msgid "Verified salon"
msgstr "Sallon i verifikuar"

#: src/twirl/templates/onboarding/done.html:4
msgid "Salon check · within 48h"
msgstr "Verifikimi i sallonit · në shqyrtim 48h"

#: src/twirl/templates/onboarding/done.html:5
msgid "The salon's listing is live."
msgstr "Listimi i sallonit është live."

#: src/twirl/templates/onboarding/done.html:6
msgid "It shows in search on free dates. The “Verified salon” badge is added once we check the address."
msgstr "Shfaqet në kërkim për datat e lira. Shenja «Sallon i verifikuar» shtohet pasi kontrollohet adresa."

#: src/twirl/templates/onboarding/done.html:8
msgid "Number verified"
msgstr "Numri i verifikuar"

#: src/twirl/templates/onboarding/done.html:9
msgid "Your item is live."
msgstr "Veshja është live."

#: src/twirl/templates/onboarding/done.html:10
msgid "It shows in search on free dates. Requests arrive with an exact date."
msgstr "Shfaqet në kërkim për datat e lira. Kërkesat vijnë me datë të saktë."

#: src/twirl/templates/onboarding/done.html:26
msgid "We check the salon within 48 hours. Until then the listing is live without the badge."
msgstr "Verifikimi i sallonit kryhet brenda 48 orëve; deri atje listimi është live pa shenjën."

#: src/twirl/templates/onboarding/done.html:27
msgid "Bookings reach your dashboard, and customers can message your WhatsApp."
msgstr "Rezervimet vijnë në panel, dhe klientët të shkruajnë në WhatsApp."

#: src/twirl/templates/onboarding/done.html:28
msgid "Add the rest of your stock. The internal code keeps the racks tidy."
msgstr "Shto pjesën tjetër të inventarit — kodi i brendshëm i mban raftet të pastra."

#: src/twirl/templates/onboarding/done.html:30
msgid "Requests arrive with an exact date. You accept or decline, no reason needed."
msgstr "Kërkesat vijnë me datë të saktë; pranon ose refuzon pa shpjegim."

#: src/twirl/templates/onboarding/done.html:31
msgid "The renter pays you at handover. Agree any deposit face to face."
msgstr "Qiramarrësi të paguan në dorëzim. Kaparen, nëse do, e merrni vesh ballë për ballë."

#: src/twirl/templates/onboarding/done.html:32
msgid "Take photos before and after each handover. They are the only proof that counts."
msgstr "Bëj foto para dhe pas dorëzimit — është e vetmja provë që numëron."

#: src/twirl/templates/onboarding/done.html:35
msgid "Add another item"
msgstr "Shto veshje tjetër"

#: src/twirl/templates/onboarding/done.html:36
msgid "Go to my dashboard"
msgstr "Shko te paneli"

#: src/twirl/templates/onboarding/dress.html:4 src/twirl/templates/onboarding/price.html:6
msgid "first item"
msgstr "veshja e parë"

#: src/twirl/templates/onboarding/dress.html:5
msgid "The first item"
msgstr "Veshja e parë"

#: src/twirl/templates/onboarding/dress.html:6
msgid ""
"One piece now, the rest from your dashboard. Photos must show the piece you hand over, not the "
"maker's catalogue."
msgstr ""
"Një copë tani, pjesa tjetër nga paneli. Fotot e sallonit duhet të tregojnë veshjen që dorëzohet, "
"jo katalogun e prodhuesit."

#: src/twirl/templates/onboarding/dress.html:6
msgid "Three photos do the job: front, side, and a close-up of the embroidery or fabric."
msgstr "Tri foto e mbyllin punën: përpara, anash, dhe një detaj i qëndisjes ose i pëlhurës."

#: src/twirl/templates/onboarding/dress.html:20
msgid "One category per listing."
msgstr "Një kategori për listim."

#: src/twirl/templates/onboarding/dress.html:23
msgid "Sizes in stock"
msgstr "Madhësitë në stok"

#: src/twirl/templates/onboarding/dress.html:29
msgid "Pick every size the salon physically has."
msgstr "Zgjidh çdo madhësi që salloni e ka fizikisht."

#: src/twirl/templates/onboarding/dress.html:29
msgid "If a tailor altered it, pick the current size."
msgstr "Nëse është ndryshuar nga rrobaqepësi, zgjidh madhësinë e tanishme."

#: src/twirl/templates/onboarding/dress.html:33 src/twirl/templates/shop/_style_fields.html:5
msgid "Description"
msgstr "Përshkrimi"

#: src/twirl/templates/onboarding/dress.html:35
msgid "Fabric, length, how often it was worn. No sales adjectives."
msgstr "Materiali, gjatësia, sa herë është veshur. Pa mbiemra reklamues."

#: src/twirl/templates/onboarding/dress.html:39
msgid "Internal code"
msgstr "Kodi i brendshëm"

#: src/twirl/templates/onboarding/dress.html:41
msgid "Optional. Only the salon sees it, on the rack and on orders."
msgstr "Opsionale. Shfaqet vetëm për sallonin, në raft dhe në porosi."

#: src/twirl/templates/onboarding/dress.html:46 src/twirl/templates/onboarding/profile.html:79
msgid "Continue"
msgstr "Vazhdo"

#: src/twirl/templates/onboarding/dress.html:48 src/twirl/templates/onboarding/price.html:45
#: src/twirl/templates/onboarding/review.html:34
msgid "Finish later"
msgstr "Përfundo më vonë"

#: src/twirl/templates/onboarding/dress.html:48 src/twirl/templates/onboarding/price.html:45
#: src/twirl/templates/onboarding/review.html:34
msgid "What you have saved stays. Continue any time from your dashboard."
msgstr "Çka ke ruajtur mbetet. Vazhdo kurdo nga paneli."

#: src/twirl/templates/onboarding/fork.html:4
msgid "First step"
msgstr "Hapi i parë"

#: src/twirl/templates/onboarding/fork.html:5
msgid "Who is renting the clothes out?"
msgstr "Kush e jep veshjen me qera?"

#: src/twirl/templates/onboarding/fork.html:6
msgid ""
"Two separate paths. Contact, handover and checks differ, so this choice decides the next "
"questions."
msgstr ""
"Dy rrugë të ndara. Kontakti, dorëzimi dhe verifikimi ndryshojnë — zgjedhja e tashme përcakton "
"pyetjet e radhës."

#: src/twirl/templates/onboarding/fork.html:12 src/twirl/web/onboarding.py:228
#: src/twirl/web/onboarding.py:283 src/twirl/web/onboarding.py:349
msgid "My own clothes"
msgstr "Veshjet e mia"

#: src/twirl/templates/onboarding/fork.html:13
msgid "A dress I have worn, or two. I list it myself and hand it over myself."
msgstr "Një fustan që e kam veshur, ose dy. E listoj vetë, e dorëzoj vetë."

#: src/twirl/templates/onboarding/fork.html:16
msgid "Paid at handover"
msgstr "Pagesa në dorëzim"

#: src/twirl/templates/onboarding/fork.html:17
msgid "I set the price and the dates"
msgstr "Çmimin dhe datat i caktoj unë"

#: src/twirl/templates/onboarding/fork.html:18
msgid "Only a phone number"
msgstr "Vetëm numri i telefonit"

#: src/twirl/templates/onboarding/fork.html:24 src/twirl/web/onboarding.py:228
#: src/twirl/web/onboarding.py:283 src/twirl/web/onboarding.py:349
msgid "Salon or business"
msgstr "Sallon ose biznes"

#: src/twirl/templates/onboarding/fork.html:25
msgid "Numbered stock. Address, opening hours and fittings in the salon."
msgstr "Inventar me numër. Adresa, orari dhe provat në sallon."

#: src/twirl/templates/onboarding/fork.html:28
msgid "Paid in the salon"
msgstr "Pagesa në sallon"

#: src/twirl/templates/onboarding/fork.html:29
msgid "Address, hours, WhatsApp"
msgstr "Adresa, orari, WhatsApp"

#: src/twirl/templates/onboarding/fork.html:30
msgid "Verified badge after a check"
msgstr "Shenja e verifikimit pas kontrollit"

#: src/twirl/templates/onboarding/fork.html:34
msgid ""
"Not sure? Choose “My own clothes”. If you open a salon later, write to us and we move your "
"listings across."
msgstr ""
"Nuk ke vendosur? Zgjidh «Veshjet e mia». Nëse hap sallon më vonë, na shkruaj dhe i kalojmë "
"listimet."

#: src/twirl/templates/onboarding/fork.html:35
msgid "Already listing? Log in"
msgstr "Ke listime? Hyr"

#: src/twirl/templates/onboarding/price.html:7 src/twirl/web/onboarding.py:192
msgid "Price and dates"
msgstr "Çmimi dhe datat"

#: src/twirl/templates/onboarding/price.html:8
msgid "Set the rent and mark the days the item can't go out. Every other day shows as free in search."
msgstr ""
"Cakto qeranë dhe shëno ditët kur veshja nuk mund të merret. Të tjerat shfaqen si të lira në "
"kërkim."

#: src/twirl/templates/onboarding/price.html:12
msgid "Rent per booking (€)"
msgstr "Qeraja për rezervim (€)"

#: src/twirl/templates/onboarding/price.html:14
msgid "Pickup two days before the event, return the day after. Cleaning included."
msgstr "Merret dy ditë para eventit, kthehet një ditë pas. Pastrimi përfshihet."

#: src/twirl/templates/onboarding/price.html:17
msgid "Payment"
msgstr "Pagesa"

#: src/twirl/templates/onboarding/price.html:18
msgid "In the salon"
msgstr "Në sallon"

#: src/twirl/templates/onboarding/price.html:18
msgid "At handover"
msgstr "Në dorëzim"

#: src/twirl/templates/onboarding/price.html:19
msgid "The customer reserves online and pays in the salon, as today. You keep your own deposit rules."
msgstr "Klienti rezervon online dhe paguan në sallon, si sot. Rregullat e kapares mbeten tuajat."

#: src/twirl/templates/onboarding/price.html:19
msgid "The renter pays you when picking the item up. Agree any deposit between you."
msgstr "Qiramarrësi të paguan kur e merr veshjen. Kaparen, nëse do, e caktoni mes jush."

#: src/twirl/templates/onboarding/price.html:23 src/twirl/web/onboarding.py:805
msgid "Busy dates"
msgstr "Datat e zëna"

#: src/twirl/templates/onboarding/price.html:36
msgid "Free"
msgstr "E lirë"

#: src/twirl/templates/onboarding/price.html:36
msgid "Busy"
msgstr "E zënë"

#: src/twirl/templates/onboarding/price.html:40
msgid "Tap the days when the item can't be picked up. You can change them any time."
msgstr "Prek datat kur veshja nuk mund të merret. Mund t'i ndryshosh kurdo."

#: src/twirl/templates/onboarding/price.html:43
msgid "See the summary"
msgstr "Shiko përmbledhjen"

#: src/twirl/templates/onboarding/profile.html:8
msgid "The salon, address and hours"
msgstr "Salloni, adresa, orari"

#: src/twirl/templates/onboarding/profile.html:9
msgid ""
"This is what customers check before they set off: where you are and when you are open. The hours "
"show on every listing."
msgstr ""
"Kjo është pjesa që kërkojnë klientët përpara se të nisen: ku je dhe kur hapesh. Orari shfaqet në "
"çdo listim."

#: src/twirl/templates/onboarding/profile.html:12
msgid "Salon name"
msgstr "Emri i sallonit"

#: src/twirl/templates/onboarding/profile.html:14
msgid "The name on your sign and on your receipts."
msgstr "Emri që shkruhet në tabelë dhe në fatura."

#: src/twirl/templates/onboarding/profile.html:18
msgid "Street and number"
msgstr "Rruga dhe numri"

#: src/twirl/templates/onboarding/profile.html:20
msgid "Shown on your listings so customers can find you."
msgstr "Shfaqet në listime që klientët të të gjejnë."

#: src/twirl/templates/onboarding/profile.html:25 src/twirl/templates/onboarding/profile.html:72
msgid "Choose the city"
msgstr "Zgjidh qytetin"

#: src/twirl/templates/onboarding/profile.html:28 src/twirl/templates/onboarding/profile.html:75
msgid "Search is filtered by city."
msgstr "Kërkimi filtrohet me qytetin."

#: src/twirl/templates/onboarding/profile.html:32
msgid "Salon WhatsApp"
msgstr "WhatsApp i sallonit"

#: src/twirl/templates/onboarding/profile.html:34
msgid "The “Message on WhatsApp” button opens this number."
msgstr "Butoni «Shkruaj në WhatsApp» hapet drejt këtij numri."

#: src/twirl/templates/onboarding/profile.html:37
msgid "Opening hours"
